# Copy to .env.local and fill in.
# Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Optional: model to try first (default gemini-3.5-flash; falls back to gemini-3.8-flash, gemini-flash-latest)
# GEMINI_MODEL=gemini-3.5-flash

# Optional: public URL for Open Graph links, e.g. https://roboeasy.kz
# NEXT_PUBLIC_SITE_URL=

# Certificates: secret for signing verification codes (16+ characters). Required in production.
# CERT_SECRET=

# Accounts, sync and classes (Supabase). Without these the app stays local-only.
# Local: `npm run db:start` prints both values (API URL and publishable/anon key).
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: show /[lang]/admin in a production build (until admin roles are checked server-side).
# ADMIN_PREVIEW=1
