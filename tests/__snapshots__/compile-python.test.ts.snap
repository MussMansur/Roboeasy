"# Test
# Snapshot
# RoboEasy AI · LEGO SPIKE App 3 (Python)

from hub import port
import runloop, motor_pair, color_sensor


async def main():
    motor_pair.pair(motor_pair.PAIR_1, port.A, port.B)
    speed = 300  # 30%, degrees per second
    while True:
        if color_sensor.reflection(port.D) < 50:
            motor_pair.move(motor_pair.PAIR_1, -30, velocity=speed)
        else:
            motor_pair.move(motor_pair.PAIR_1, 30, velocity=speed)
        await runloop.sleep_ms(10)


runloop.run(main())
"
